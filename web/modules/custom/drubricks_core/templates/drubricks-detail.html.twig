{#
/**
 * @file
 * Details pane (kit .content): toolbar with record actions + content.
 *
 * Variables: title, actions{key:{title,url,icon,danger,attributes,disabled,reason}}, content, empty, back_url,
 * inspector (the record has an inspector: show its toggle).
 * A content render array with '#drubricks_header' => TRUE brings its own
 * heading (e.g. drubricks:detail-header); the plain h2 is left out.
 */
#}
<main class="content" id="drubricks-detail" tabindex="-1" aria-label="{{ title ?: 'Details'|t }}">
  <header class="pane-header">
    <button class="icon-btn show-sidebar-btn" type="button" data-action="toggle-sidebar" title="{{ 'Show Sidebar'|t }}">{{ icon('kit', 'i-sidebar') }}</button>
    <button class="tb-group tb-btn back-btn" type="button" data-action="back">{{ icon('kit', 'i-chevron-left') }}<span>{{ 'Back'|t }}</span></button>
    {% if actions %}
      <div class="tb-group">
        {% for key, action in actions %}
          {% set ref = action.icon|split(':', 2) %}
          {% if action.disabled %}
            {# Not possible now (e.g. Delete while other records use this one): say why. #}
            <button type="button" class="tb-btn" aria-disabled="true" data-tip="{{ action.reason }}" title="{{ action.title }}: {{ action.reason }}" aria-label="{{ action.title }}: {{ action.reason }}" data-action-key="{{ key }}">{{ icon(ref|length > 1 ? ref|first : 'kit', ref|length > 1 ? ref|last : 'i-' ~ ref|last) }}</button>
          {% else %}
            <a class="tb-btn{{ action.danger ? ' danger' }}" href="{{ action.url }}" data-tip="{{ action.title }}" title="{{ action.title }}" data-action-key="{{ key }}"{{ create_attribute(action.attributes) }}>{{ icon(ref|length > 1 ? ref|first : 'kit', ref|length > 1 ? ref|last : 'i-' ~ ref|last) }}</a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    <div class="spacer"></div>
    {% if inspector %}
      <button class="icon-btn" type="button" data-action="toggle-inspector" title="{{ 'Show Inspector'|t }}">{{ icon('kit', 'i-sidebar-right') }}</button>
    {% endif %}
  </header>
  <div class="pane-body selectable">
    {% if content %}
      {% if title and not content['#drubricks_header']|default(false) %}<h2 class="mt-2 mb-4 text-[22px] font-bold tracking-tight">{{ title }}</h2>{% endif %}
      <div class="drubricks-detail-body max-w-[760px]">{{ content }}</div>
    {% else %}
      <div class="empty-state">{{ empty }}</div>
    {% endif %}
  </div>
</main>
