{
    "name": "drubricks/drubricks",
    "description": "Drubricks \u2014 starter for business applications on Drupal 12 with its own UI kit.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drubricks.com",
    "support": {
        "issues": "https://github.com/drubricks/drubricks/issues",
        "source": "https://github.com/drubricks/drubricks",
        "security": "https://github.com/drubricks/drubricks/blob/master/SECURITY.md"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "drupal/config_log": "^4@dev",
        "drupal/core-composer-scaffold": "^12.0@beta",
        "drupal/core-project-message": "^12.0@beta",
        "drupal/core-recipe-unpack": "^12.0@beta",
        "drupal/core-recommended": "^12.0@beta",
        "drupal/gin_login": "^2.1",
        "drupal/login_emailusername": "^3",
        "drupal/masquerade": "^2.2",
        "drupal/project_browser": "^2.1",
        "drush/drush": "^13.8 || ^14@dev"
    },
    "require-dev": {
        "drupal/core-dev": "^12.0@beta"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true,
            "symfony/runtime": true
        },
        "bin-dir": "vendor/bin",
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": {
            "drupal/core": "source",
            "*": "dist"
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ]
        }
    }
}
