{#
/**
 * @file
 * A project: header (tile, status, due date), progress, stats, tasks grouped
 * by status (priority, due date, assignee), description and details.
 * compact: the side panel (no header).
 */
#}
{% set sub %}
  {%- if status %}{{ include('drubricks:pill', {label: status.label, color: status.color}, with_context = false) }}{% endif %}
  {%- if due %}{% if status %}<span aria-hidden="true">·</span>{% endif %}<span class="{{ due.late ? 'overdue' }}">{% if due.late %}{{ 'Overdue since @date'|t({'@date': due.label}) }}{% else %}{{ 'Due @date'|t({'@date': due.label}) }}{% endif %}</span>{% endif %}
{% endset %}
{% set body %}
  {{ include('drubricks:progress', {value: progress.value, color: color|default(''), label: progress.label, attributes: create_attribute({'class': ['mb-1', compact ? '' : 'max-w-[480px]']|filter(c => c)})}, with_context = false) }}

  {% embed 'drubricks:stats' with {stats: stats, attributes: create_attribute({'class': ['!mt-4', '[grid-template-columns:repeat(3,minmax(0,1fr))]']})} only %}
    {% block content %}{% for stat in stats %}{{ include('drubricks:stat', stat, with_context = false) }}{% endfor %}{% endblock %}
  {% endembed %}

  {% for state, group in groups %}
    <div class="group-title flex items-center gap-2"><span class="dot" style="background: {{ color(group.color) }}" aria-hidden="true"></span>{{ group.label }} <span class="dim">{{ group.tasks|length }}</span></div>
    {% embed 'drubricks:panel' with {group: group, attributes: create_attribute({'class': ['[&>.p-row:first-child]:border-t-0']})} only %}
      {% block content %}
        {% for task in group.tasks %}
          {% embed 'drubricks:p-row' with {title: task.title, subtitle: task.key ~ (task.due.label ? ' · ' ~ (task.due.late ? 'overdue since @date'|t({'@date': task.due.label}) : 'due @date'|t({'@date': task.due.label})) : ''), task: task}|merge(task.link) only %}
            {% block leading %}{% if task.priority %}{{ include('drubricks:priority', {level: task.priority, label: task.priority_label}, with_context = false) }}{% else %}<span class="w-4"></span>{% endif %}{% endblock %}
            {% block trailing %}
              {%- if task.due.late %}{{ include('drubricks:pill', {label: 'Overdue'|t, color: 'red', icon: 'clock'}, with_context = false) }}{% endif %}
              {%- if task.assignee %}{{ include('drubricks:avatar', {name: task.assignee.name, color: task.assignee.color, size: 'xs'}, with_context = false) }}
              {%- else %}<span class="dim text-xs">{{ 'Unassigned'|t }}</span>{% endif %}
            {% endblock %}
          {% endembed %}
        {% endfor %}
      {% endblock %}
    {% endembed %}
  {% else %}
    {{ include('drubricks:empty-line', {text: 'No tasks in this project yet'|t, attributes: create_attribute({'class': ['mt-4']})}, with_context = false) }}
  {% endfor %}

  {% if description %}
    {{ include('drubricks:group-title', {title: 'Description'|t}, with_context = false) }}
    <div class="group px-3 py-2.5 whitespace-pre-line leading-relaxed">{{ description }}</div>
  {% endif %}

  {% include '@drubricks_core/drubricks-facts.html.twig' with {title: 'Details'|t, facts: facts} only %}
  {{ fields }}
{% endset %}

<div class="[&_:is(a.p-row,a.mini,a.stat,a.feed-item)]:text-inherit">
{% if compact %}
  <div class="d-sub mb-3">{{ sub }}</div>
  {{ body }}
{% else %}
  {% embed 'drubricks:detail-header' with {title: title, tile: true, avatar_color: color|default(''), sub: sub, body: body} only %}
    {% block subtitle_markup %}{{ sub }}{% endblock %}
    {% block content %}{{ body }}{% endblock %}
  {% endembed %}
{% endif %}
</div>
