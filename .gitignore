# Local DDEV configuration (created by launch-drubricks.sh, like Open Intranet / Drupal CMS)
/.ddev/
.ddev-docker-compose-*

# The starter keeps no lock (like Drupal CMS and Open Intranet): a new project
# resolves the newest matching versions on its first composer install, and
# scripts/start-own-project.sh drops this line so the project commits its lock.
/composer.lock

# Composer-managed code
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/Commands/contrib/

# Scaffolded files in the web root (regenerated by composer install)
/web/*
!/web/modules/
/web/modules/*
!/web/modules/custom/
!/web/themes/
/web/themes/*
!/web/themes/custom/
!/web/profiles/
/web/profiles/*
!/web/profiles/custom/

# Theme build
node_modules/
/web/themes/custom/*/node_modules/

# Local / test output
/test-results/
/playwright-report/
.phpunit.cache/
.DS_Store

tmp/*

