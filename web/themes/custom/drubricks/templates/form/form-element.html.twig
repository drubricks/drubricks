{#
/**
 * @file
 * Form element wrapper → kit form item: label, control, hint (.field-hint),
 * inline error (.field-error). Checkboxes and radios: control, then the label.
 *
 * Same variables as core's form-element.html.twig; errors come from
 * inline_form_errors.
 */
#}
{%
  set classes = [
    'js-form-item',
    'form-item',
    'form-type-' ~ type|clean_class,
    'js-form-type-' ~ type|clean_class,
    'form-item-' ~ name|clean_class,
    'js-form-item-' ~ name|clean_class,
    title_display not in ['after', 'before'] ? 'form-no-label',
    disabled == 'disabled' ? 'form-disabled',
    errors ? 'form-item--error',
  ]
%}
{%
  set description_classes = [
    'description',
    'field-hint',
    description_display == 'invisible' ? 'visually-hidden',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {% if label_display in ['before', 'invisible'] %}
    {{ label }}
  {% endif %}
  {% if description_display == 'before' and description.content %}
    <div{{ description.attributes.addClass(description_classes) }}>{{ description.content }}</div>
  {% endif %}
  {% if prefix is not empty or suffix is not empty %}
    <div class="form-item-affix">
      {% if prefix is not empty %}<span class="field-prefix">{{ prefix }}</span>{% endif %}
      {{ children }}
      {% if suffix is not empty %}<span class="field-suffix">{{ suffix }}</span>{% endif %}
    </div>
  {% else %}
    {{ children }}
  {% endif %}
  {% if label_display == 'after' %}
    {{ label }}
  {% endif %}
  {% if errors %}
    <div class="form-item--error-message field-error">{{ errors }}</div>
  {% endif %}
  {% if description_display in ['after', 'invisible'] and description.content %}
    <div{{ description.attributes.addClass(description_classes) }}>{{ description.content }}</div>
  {% endif %}
</div>
