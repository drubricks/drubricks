{# Trigger for UI.popover: the content waits in a <template>. #}
{% set icon_only = icon and not label %}
{% set classes = icon_only or variant == 'icon' ? ['icon-btn'] : ['btn', variant in ['primary', 'destructive'] ? variant]|filter(c => c) %}
{% set attributes = attributes.addClass(classes).setAttribute('type', 'button').setAttribute('data-drubricks-popover', '').setAttribute('aria-haspopup', 'dialog') %}
{% set attributes = attributes.setAttribute('data-options', {width: width|default(260), label: popover_label}|json_encode) %}
{% if title %}{% set attributes = attributes.setAttribute('title', title) %}{% endif %}
<button{{ attributes }}>{{ icon('kit', 'i-' ~ (icon)) }}{{ label }}</button><template data-drubricks-popover-content>{% block content %}{{ content }}{% endblock %}</template>
